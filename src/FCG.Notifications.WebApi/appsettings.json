{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "FCG.Notifications": "Debug"
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "UserCreatedTopic": "user-created",
    "GroupId": "fcg-notifications-consumer-group"
  },
  "Email": {
    "ConnectionString": "endpoint=https://your-acs-resource.communication.azure.com/;accesskey=your-access-key",
    "SenderAddress": "DoNotReply@your-domain.com"
  }
}
